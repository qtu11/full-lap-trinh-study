<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<configuration xmlns="http://www.cisco.com/cids/idiom" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.cisco.com/cids/idiom http://www.cisco.com/cids/idiom/1.00/idiom.xsd" schemaVersion="1.00">
